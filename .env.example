# --- Bombay Silvers environment variables ---
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Supabase project (browser client — safe to expose, RLS-protected)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only (bypasses RLS — keep SECRET)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Live bullion rates (server-side only)
BULLIONLIVE_API_KEY=
# BULLIONLIVE_API_URL=
# BULLIONLIVE_CACHE_TTL_MS=

# Direct Postgres + Management API (used by migration scripts only)
# SUPABASE_DB_PASSWORD=
# SUPABASE_ACCESS_TOKEN=