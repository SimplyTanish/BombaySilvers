# --- Bombay Silvers environment variables ---
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Supabase project (browser client — safe to expose, RLS-protected)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only (bypasses RLS — keep SECRET)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Live bullion rates (server-side only) — derived from COMEX + USD/INR
# via Yahoo Finance; no API key required.
# MCX_CACHE_TTL_MS=            # in-memory cache TTL (ms), default 30000
# MCX_GOLD_DUTY_PCT=          # gold duty/premium % over COMEX, default 13
# MCX_SILVER_DUTY_PCT=        # silver duty/premium % over COMEX, default 17

# Direct Postgres + Management API (used by migration scripts only)
# SUPABASE_DB_PASSWORD=
# SUPABASE_ACCESS_TOKEN=